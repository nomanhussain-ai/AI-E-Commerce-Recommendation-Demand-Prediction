# Used when APP_ENV = "dev" in app/config.py.  Copy to `.env.dev`.
# Shared development database server.
# DB_NAME = the PostgreSQL database name (plain identifier, no spaces).

DB_DRIVER=postgresql+asyncpg
DB_HOST=CHANGE-ME.dev-db.internal
DB_PORT=5432
DB_USER=core_api
DB_PASSWORD=CHANGE-ME
DB_NAME=ecommerce
DB_ECHO=false
