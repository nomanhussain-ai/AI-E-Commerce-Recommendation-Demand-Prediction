# core-api — shared settings.  Copy to `.env`.
#
# The database connection string is NOT here — it is assembled in app/config.py
# from the DB_* keywords in the per-environment file:
#   .env.local   used when APP_ENV = "local"   (app/config.py, top of file)
#   .env.dev     used when APP_ENV = "dev"
# Copy .env.local.example / .env.dev.example accordingly.

DEBUG=true

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true          # set false locally if you have no Redis
RATE_LIMIT_AUTH_PER_MIN=10

JWT_SECRET=dev-insecure-jwt-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGINS=http://localhost:3000

ML_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=devInternalKey
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=devMasterKey_change_me
