# Used when APP_ENV = "local" in app/config.py.  Copy to `.env.local`.
# PostgreSQL running on your own machine.
#
# DB_NAME is the PostgreSQL *database* name — a plain identifier, no spaces
# (e.g. ecommerce), NOT the project title.
#
# No PostgreSQL yet? Use the SQLite fallback instead — put this one line in
# `.env` and skip alembic (tables auto-create on startup):
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db

DB_DRIVER=postgresql+asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=ecommerce
DB_ECHO=false
