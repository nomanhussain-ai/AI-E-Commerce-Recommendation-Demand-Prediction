# ─────────────────────────────────────────────────────────────
#  ecommerce-ai-platform — sample environment (copy to .env)
#  Stack: Next.js 16 + FastAPI (core-api) + FastAPI (ml-service)
#         + worker (Arq) + PostgreSQL + Meilisearch + Redis + MinIO
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ecommerce
# used by core-api / ml-service / worker
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ecommerce
# read-only role for ml-service (create manually / via init.sql)
ML_DATABASE_URL=postgresql+asyncpg://ml_ro:ml_ro@localhost:5432/ecommerce

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Meilisearch ──
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=devMasterKey_change_me
# scoped key (search-only, products index) — generate after first boot, used by Next.js
MEILI_SEARCH_KEY=devSearchKey

# ── Object storage (MinIO locally / S3 in prod) ──
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ecommerce-assets
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345

# ── core-api ──
CORE_API_PORT=8000
JWT_SECRET=devJwtSecret_change_me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_ASSISTANT_PER_MIN=20

# ── SMTP email (leave empty for local dev OTP display) ──
# Gmail: smtp.gmail.com / 587 / STARTTLS + a 16-character App Password
# Brevo: smtp-relay.brevo.com / 587 / STARTTLS + SMTP key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ── ml-service ──
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_PORT=8001
MODEL_DIR=./services/ml-service/app/models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# shared secret core-api <-> ml-service <-> worker (internal calls)
INTERNAL_API_KEY=devInternalKey

# ── worker (Arq) ──
NIGHTLY_CRON_HOUR=2
SEARCH_OUTBOX_POLL_SECONDS=2

# ── Next.js (web) ──
# server-side base URL for RSC / Route Handlers (never exposed to browser)
CORE_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_SECRET=devCookieSecret_change_me
COOKIE_SECURE=false          # true in production (HTTPS)

# ── Assistant / LLM (M4, optional) ──
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5-20251001

# ── Datasets (seed) ──
DATA_DIR=./data
RETAILROCKET_DIR=./data/raw/retailrocket
ONLINE_RETAIL_DIR=./data/raw/online-retail-ii
SYNTHETIC_MONTHS=18
